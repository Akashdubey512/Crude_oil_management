# ─── Environment Configuration (Example) ───
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL in production, defaults to SQLite predictions.db if empty)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# Directory Overrides (defaults to workspace paths)
# MODEL_DIR=models
# DATA_DIR=data

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=*

# API Configuration
API_RATE_LIMIT=60
REQUEST_TIMEOUT=10.0
MODEL_LOAD_TIMEOUT=5.0

# External API Keys (Optional in Dev, required for real-time live data fetching)
FRED_API_KEY=your_fred_api_key_here
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
PORTWATCH_BASE_URL=https://portwatch.imf.org/api
GFW_BASE_URL=https://gateway.gfw.org/v2
