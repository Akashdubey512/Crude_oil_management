# Auto-detect text files and normalize line endings
* text=auto

# Python source files
*.py text eol=lf

# Frontend TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Markdown and docs
*.md text eol=lf

# YAML/config
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# CSV/TSV data files
*.csv text eol=lf

# Binary files — do not modify
*.pkl binary
*.xls binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
